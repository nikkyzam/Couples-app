# Copy this file to .env.local and fill in your Supabase project values to turn
# on cross-device sync (separate accounts on separate phones). Leave them unset
# to run Kindle fully offline as a private, per-device app.
#
# Find these in your Supabase dashboard → Project Settings → API.
# The anon key is a public, client-side key (safe to ship in the app).

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# OPTIONAL — enables automatic schema setup on startup (npm run dev / preview).
# This is your database connection string and contains the DB PASSWORD, so it is
# a secret. It is NOT prefixed with VITE_, so it never reaches the browser.
# In Supabase: Connect (or Settings → Database) → Connection string →
# "Session pooler", copy the postgresql:// URI and put your DB password in it.
# Leave blank to set up the schema manually in the SQL Editor instead.
SUPABASE_DB_URL=
